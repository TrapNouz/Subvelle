<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window background matches the Compose theme so there is no white flash at launch. -->
    <style name="Theme.Subvelle" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/space_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <color name="space_background">#FF0B0B0E</color>
    <color name="icon_background">#FF14121F</color>
</resources>
